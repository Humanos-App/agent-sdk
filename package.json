{
  "name": "@humanos-ai/agent-sdk",
  "version": "0.4.3",
  "type": "module",
  "description": "Humanos Agent SDK — put an AI agent under a mandate: its own key and proof of possession, the ViaGuard that verifies every tool call before it runs, the Humanos connector client, and an MCP server and governing proxy. The VIA protocol is @humanos-ai/via-sdk.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Humanos-App/agent-sdk.git"
  },
  "homepage": "https://github.com/Humanos-App/agent-sdk#readme",
  "bugs": {
    "url": "https://github.com/Humanos-App/agent-sdk/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/adapters/ai-sdk.d.ts",
      "import": "./dist/adapters/ai-sdk.js"
    },
    "./claude-agent-sdk": {
      "types": "./dist/adapters/claude-agent-sdk.d.ts",
      "import": "./dist/adapters/claude-agent-sdk.js"
    },
    "./langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "import": "./dist/adapters/langchain.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "bin": {
    "humanos": "./dist/bin/humanos.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node scripts/write-version.mjs",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check-types && npm test",
    "precheck-types": "node scripts/write-version.mjs",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "check-types:frameworks": "tsc -p test/frameworks/tsconfig.json --noEmit",
    "pretest": "node scripts/write-version.mjs",
    "test": "vitest run",
    "test:frameworks": "vitest run --config vitest.frameworks.config.ts",
    "test:live": "vitest run --config vitest.live.config.ts",
    "walkthrough": "node test/walkthrough/run.mjs",
    "walkthrough:setup": "node test/walkthrough/setup.mjs",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@humanos-ai/via-sdk": "^0.8.1",
    "@langchain/core": "^1.0.1",
    "ai": ">=5",
    "langchain": "^1.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@ai-sdk/mcp": "^2.0.90",
    "@anthropic-ai/sdk": "^1.4.0",
    "@humanos-ai/via-sdk": "^0.8.1",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/mcp-adapters": "^2.0.2",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@types/node": "^22.20.0",
    "ai": "^7.0.162",
    "langchain": "^1.6.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "zod": "^4.6.7"
  },
  "//boundary": "The protocol is the PACKAGE @humanos-ai/via-sdk, a peer, so an agent that also verifies things itself shares one copy.",
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "langchain": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    }
  }
}
